// GamID TESTING - Cloudflare Workers Static Assets. Phase 0a (accepted): static files only, byte-identical to GitHub Pages. Phase 1 (this): adds two dynamic
// routes (cf-worker/worker.mjs) - /@<handle> and /@<handle>/intro.webm - run first so they see the request before Cloudflare's own asset routing (which
// 307-redirects a literal "/@black" to "/%40black" - observed in Phase 0a). Every other path is completely unchanged: no Worker code runs, the accepted static
// behavior (incl. the accepted 404) applies.
// Run `node scripts/stage-cloudflare.mjs` first: it builds .cloudflare-stage/ from dist/ for Cloudflare deployment.
// Canonical Cloudflare TESTING frontend. Legacy Pages is retired following manual acceptance and explicit authorization; see docs/CLOUDFLARE-AUTH-MIGRATION.md.
{
  "name": "gamid-testing-static",
  "compatibility_date": "2026-01-01",
  "main": "./cf-worker/worker.mjs",
  "workers_dev": true,
  "preview_urls": false,
  // Media-route hardening (cf-worker/worker.mjs withinRateLimit, 2026-10-27): Workers Rate Limiting, approximate and per Cloudflare location. Media = per client IP
  // and handle on /@<handle>/intro.webm and /intro-discord.webm; crawler = the same key for Discord's crawler / media proxy; page = per client IP on /@<handle>.
  "ratelimits": [
    { "name": "MEDIA_LIMITER", "namespace_id": "27101", "simple": { "limit": 120, "period": 60 } },
    { "name": "CRAWLER_LIMITER", "namespace_id": "27102", "simple": { "limit": 1200, "period": 60 } },
    { "name": "PAGE_LIMITER", "namespace_id": "27103", "simple": { "limit": 300, "period": 60 } }
  ],
  "assets": {
    "directory": "./.cloudflare-stage",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/@*", "/media/*"]
  },
  // Media delivery Architecture F, TESTING pilot (DEC-0013; cf-worker/media-r2.mjs): the PRIVATE bucket (no public access, no r2.dev, no custom domain), read and
  // written only by this Worker. Delivery stays OFF until MEDIA_R2_DELIVERY is "on" (Mazen's approval); the signing / ingest keys are Worker secrets, never here.
  "r2_buckets": [
    { "binding": "MEDIA_R2", "bucket_name": "gamid-media-testing" }
  ],
  "vars": {
    "MEDIA_R2_DELIVERY": "on"
  }
}
